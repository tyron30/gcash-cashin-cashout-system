# Copy this file to ".env" (same folder) and fill in the two values.
# Supabase dashboard -> Project Settings -> API (also under the "Connect" button).

# Project URL, looks like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_). On older projects this is
# the "anon" public key. It is safe in the browser ONLY because Row Level
# Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the "secret" key or the "service_role" key in this file or
# anywhere in the frontend. Anything starting with VITE_ is visible to every
# visitor of the website.
